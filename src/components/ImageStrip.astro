---
import type { GalleryImage } from "../data/gallery";
import SmartImage from "./SmartImage.astro";

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<div class="-mx-5 overflow-x-auto px-5 md:-mx-8 md:px-8">
  <ul class="flex snap-x snap-mandatory gap-3 pb-2">
    {
      images.map((image) => {
        const Tag = image.href ? "a" : "div";
        return (
          <li class="w-[78vw] shrink-0 snap-start sm:w-[46vw] lg:w-[30vw]">
            <Tag href={image.href} class="group block">
              <div class="aspect-[4/3] overflow-hidden bg-paper-deep">
                <SmartImage
                  src={image.src}
                  alt={image.alt}
                  class="transition-transform duration-700 group-hover:scale-[1.03]"
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 78vw"
                />
              </div>
              <p class="eyebrow mt-3">{image.caption}</p>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</div>
