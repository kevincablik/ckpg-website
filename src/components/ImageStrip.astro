---
import type { GalleryImage } from "../data/gallery";
import SmartImage from "./SmartImage.astro";

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<div class="overflow-x-auto">
  <ul class="flex snap-x snap-mandatory gap-1 pb-2">
    {
      images.map((image) => {
        const Tag = image.href ? "a" : "div";
        return (
          <li class="w-[86vw] shrink-0 snap-start sm:w-[54vw] lg:w-[38vw]">
            <Tag href={image.href} class="group block">
              <div class="aspect-[3/2] overflow-hidden bg-paper-deep">
                <SmartImage
                  src={image.src}
                  alt={image.alt}
                  class="transition-transform duration-700 group-hover:scale-[1.03]"
                  sizes="(min-width: 1024px) 38vw, (min-width: 640px) 54vw, 86vw"
                />
              </div>
              <p class="eyebrow mt-3 px-5 md:px-8">{image.caption}</p>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</div>
