---
import type { FeaturedProject } from "../data/projects";
import type { GalleryImage } from "../data/gallery";
import BleedPhoto from "./BleedPhoto.astro";
import ButtonLink from "./ButtonLink.astro";
import SmartImage from "./SmartImage.astro";
import ImageGallery from "./ImageGallery.astro";

interface Props {
  project: FeaturedProject;
  gallery: GalleryImage[];
  reverse?: boolean;
  detail?: boolean;
}

const { project, gallery, reverse = false, detail = false } = Astro.props;
const hero = gallery[0];
const thumbs = gallery.slice(1, 5);
---

<article id={project.id} class="scroll-mt-20">
  <section
    class="relative flex min-h-[78svh] items-end overflow-hidden bg-ink text-paper md:min-h-[92svh]"
  >
    {
      hero && (
        <BleedPhoto src={hero.src} alt={hero.alt} priority={detail} />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/45 to-transparent"></div>
    <div
      class:list={[
        "relative z-10 mx-auto flex w-full max-w-6xl px-5 pb-10 pt-32 md:px-8 md:pb-16",
        reverse && "justify-end",
      ]}
    >
      <div class:list={["max-w-xl", reverse && "md:text-right"]}>
        <p class="eyebrow text-paper/70">{project.kicker}</p>
        <h2 class="font-display mt-3 text-4xl font-normal leading-[1.05] tracking-tight md:text-6xl">
          {project.name}
        </h2>
        <p class="font-display mt-2 text-xl italic text-paper/85 md:text-2xl">
          {project.headline}
        </p>
        {
          !detail && (
            <p class="mt-5 text-sm font-light leading-relaxed text-paper/80 md:text-[0.98rem]">
              {project.summary}
            </p>
          )
        }
        {
          !detail && (
            <div class:list={["mt-8 flex flex-wrap gap-3", reverse && "md:justify-end"]}>
              <ButtonLink href={project.href} variant="light">
                View project
              </ButtonLink>
              {project.externalUrl && (
                <ButtonLink href={project.externalUrl} variant="ghost-light" external>
                  {project.externalLabel ?? "Project site"}
                </ButtonLink>
              )}
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    detail && (
      <section class="border-b border-line bg-paper">
        <div class="mx-auto grid max-w-6xl gap-10 px-5 py-10 md:grid-cols-12 md:gap-14 md:px-8 md:py-14">
          <div class="space-y-4 md:col-span-7">
            {project.body.map((paragraph) => (
              <p class="max-w-2xl text-[0.95rem] font-light leading-relaxed text-muted">
                {paragraph}
              </p>
            ))}
          </div>
          <div class="md:col-span-5">
            <ul class="space-y-3 border-t border-line pt-6 md:border-t-0 md:pt-0">
              {project.bullets.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink-soft">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3">
              {project.externalUrl && (
                <ButtonLink href={project.externalUrl} variant="ghost-dark" external>
                  {project.externalLabel ?? "Project site"}
                </ButtonLink>
              )}
              <ButtonLink href={`/contact?interest=${project.id}`} variant="dark">
                Inquire
              </ButtonLink>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    !detail && thumbs.length > 0 && (
      <div class="grid grid-cols-2 gap-1 md:grid-cols-4">
        {thumbs.map((image) => (
          <a href={project.href} class="aspect-[3/2] overflow-hidden bg-paper-deep">
            <SmartImage
              src={image.src}
              alt={image.alt}
              sizes="(min-width: 768px) 25vw, 50vw"
              class="transition-transform duration-700 hover:scale-[1.03]"
            />
          </a>
        ))}
      </div>
    )
  }

  {
    detail && gallery.length > 1 && (
      <div class="bg-ink">
        <ImageGallery images={gallery.slice(1)} />
      </div>
    )
  }
</article>
