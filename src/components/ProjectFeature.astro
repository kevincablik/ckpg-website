---
import type { FeaturedProject } from "../data/projects";
import type { GalleryImage } from "../data/gallery";
import BleedPhoto from "./BleedPhoto.astro";
import ButtonLink from "./ButtonLink.astro";
import ImageGallery from "./ImageGallery.astro";

interface Props {
  project: FeaturedProject;
  gallery: GalleryImage[];
}

const { project, gallery } = Astro.props;
const hero = gallery[0];
---

<article id={project.id} class="scroll-mt-20">
  <section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-ink text-paper">
    {hero && <BleedPhoto src={hero.src} alt={hero.alt} priority />}
    <div class="absolute inset-0 bg-ink/25"></div>
    <div class="relative z-10 px-5 py-24 text-center">
      <p class="eyebrow text-paper/75">{project.kicker}</p>
      <h2 class="font-display mt-4 text-5xl font-normal leading-[1.05] tracking-tight md:text-7xl">
        {project.name}
      </h2>
      <p class="font-display mt-3 text-xl italic text-paper/90 md:text-2xl">{project.headline}</p>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-2xl px-5 py-12 text-center md:py-16">
      {
        project.body.map((paragraph) => (
          <p class="mt-4 text-[0.98rem] font-light leading-relaxed text-muted first:mt-0">
            {paragraph}
          </p>
        ))
      }
      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-ink-soft">
        {
          project.bullets.map((item) => (
            <li>{item}</li>
          ))
        }
      </ul>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {
          project.externalUrl && (
            <ButtonLink href={project.externalUrl} variant="ghost-dark" external>
              {project.externalLabel ?? "Project site"}
            </ButtonLink>
          )
        }
        <ButtonLink href={`/contact?interest=${project.id}`} variant="dark">
          Inquire
        </ButtonLink>
      </div>
    </div>
  </section>

  {
    gallery.length > 1 && (
      <ImageGallery images={gallery.slice(1)} />
    )
  }
</article>
