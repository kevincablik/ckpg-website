---
import type { ImageMetadata } from "astro";
import SmartImage from "./SmartImage.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  priority?: boolean;
  sizes?: string;
}

const { src, alt, priority = false, sizes = "100vw" } = Astro.props;
---

<div
  class="absolute inset-0 [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_picture]:block [&_picture]:h-full [&_picture]:w-full"
>
  <SmartImage
    src={src}
    alt={alt}
    class="h-full w-full object-cover"
    widths={[800, 1200, 1800, 2400]}
    sizes={sizes}
    priority={priority}
  />
</div>
