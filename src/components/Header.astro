---
import { nav, site } from "../data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  const normalized = href.replace(/\/$/, "") || "/";
  return currentPath === normalized;
}
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-ink/75 text-paper backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-3 md:px-8">
    <a href="/" class="flex min-w-0 shrink items-center gap-3 md:gap-4" aria-label={`${site.name} home`}>
      <img
        src="/images/ckpg-mark.png"
        alt=""
        class="h-10 w-auto md:h-12"
        width="900"
        height="700"
      />
      <span class="hidden pt-0.5 text-[0.62rem] font-medium leading-tight tracking-[0.22em] uppercase sm:block">
        Property Group LLC
      </span>
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-[0.72rem] font-medium tracking-[0.2em] uppercase transition-opacity hover:opacity-100",
              isActive(item.href) ? "opacity-100" : "opacity-70",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center md:hidden"
      data-menu-button
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <span class="sr-only">Menu</span>
      <span class="flex h-3.5 w-5 flex-col justify-between" aria-hidden="true">
        <span class="block h-px w-full bg-paper"></span>
        <span class="block h-px w-full bg-paper"></span>
        <span class="block h-px w-full bg-paper"></span>
      </span>
    </button>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-white/10 px-5 py-4 md:hidden"
    data-mobile-nav
    aria-label="Mobile"
  >
    <ul class="flex flex-col gap-1">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "block py-3 text-sm tracking-[0.18em] uppercase",
                isActive(item.href) ? "text-paper" : "text-paper/70",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector("[data-menu-button]");
  const panel = document.querySelector("[data-mobile-nav]");

  if (button instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    button.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });
  }
</script>
