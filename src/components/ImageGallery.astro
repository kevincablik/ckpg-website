---
import type { GalleryImage } from "../data/gallery";
import SmartImage from "./SmartImage.astro";

interface Props {
  images: GalleryImage[];
  dense?: boolean;
}

const { images } = Astro.props;
---

<div class="grid grid-cols-1 gap-1 md:grid-cols-2">
  {
    images.map((image, index) => (
      <figure
        class:list={[
          "overflow-hidden bg-paper-deep",
          index === 0 && "md:col-span-2",
        ]}
      >
        <div
          class:list={[
            index === 0
              ? "min-h-[58vh] aspect-[16/10] md:aspect-auto md:min-h-[86vh]"
              : "aspect-[3/2] min-h-[38vh] md:min-h-[56vh]",
          ]}
        >
          <SmartImage
            src={image.src}
            alt={image.alt}
            sizes={index === 0 ? "100vw" : "(min-width: 768px) 50vw, 100vw"}
            priority={index === 0}
          />
        </div>
        <figcaption class="sr-only">{image.caption}</figcaption>
      </figure>
    ))
  }
</div>
