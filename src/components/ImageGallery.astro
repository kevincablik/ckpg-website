---
import type { GalleryImage } from "../data/gallery";
import SmartImage from "./SmartImage.astro";

interface Props {
  images: GalleryImage[];
  dense?: boolean;
}

const { images, dense = false } = Astro.props;
---

<div
  class:list={[
    "grid gap-1",
    dense ? "grid-cols-2 md:grid-cols-4" : "grid-cols-2 md:grid-cols-3",
  ]}
>
  {
    images.map((image, index) => (
      <figure
        class:list={[
          "overflow-hidden bg-paper-deep",
          !dense && index === 0 && "col-span-2 md:col-span-2 md:row-span-2",
        ]}
      >
        <div
          class:list={[
            !dense && index === 0
              ? "min-h-[42vh] aspect-[4/3] md:aspect-auto md:h-full md:min-h-[78vh]"
              : "aspect-[3/2] min-h-[22vh] md:min-h-[32vh]",
          ]}
        >
          <SmartImage
            src={image.src}
            alt={image.alt}
            sizes={
              !dense && index === 0
                ? "(min-width: 768px) 66vw, 100vw"
                : "(min-width: 768px) 33vw, 50vw"
            }
            priority={index === 0}
          />
        </div>
        <figcaption class="sr-only">{image.caption}</figcaption>
      </figure>
    ))
  }
</div>
