---
import type { FeaturedProject } from "../data/projects";
import type { GalleryImage } from "../data/gallery";
import SmartImage from "./SmartImage.astro";

interface Props {
  project: FeaturedProject;
  image: GalleryImage;
  featured?: boolean;
  overlay?: boolean;
}

const { project, image, featured = false, overlay = true } = Astro.props;
---

<a href={project.href} class="group block">
  <div
    class:list={[
      "relative overflow-hidden bg-paper-deep",
      featured ? "min-h-[82svh] md:min-h-[90svh]" : "aspect-[4/3] min-h-[46vh] md:min-h-[64vh]",
    ]}
  >
    <SmartImage
      src={image.src}
      alt={image.alt}
      sizes={featured ? "100vw" : "(min-width: 768px) 50vw, 100vw"}
      class="transition-transform duration-700 group-hover:scale-[1.03]"
      widths={[800, 1200, 1800, 2400]}
    />
    {
      overlay && (
        <>
          <div class="absolute inset-0 bg-ink/20 transition-colors duration-500 group-hover:bg-ink/30"></div>
          <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center text-paper">
            <h3 class="font-display text-4xl font-normal tracking-tight md:text-6xl">{project.name}</h3>
            <p class="mt-3 text-[0.72rem] font-medium tracking-[0.18em] uppercase text-paper/85">
              {project.location}
            </p>
          </div>
        </>
      )
    }
  </div>
  {
    !overlay && (
      <div class="px-1 pt-4">
        <h3 class="font-display text-2xl md:text-3xl">{project.name}</h3>
        <p class="mt-1 text-sm tracking-wide text-stone">{project.location}</p>
      </div>
    )
  }
</a>
