---
import type { ImageMetadata } from "astro";
import BleedPhoto from "./BleedPhoto.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  eyebrow: string;
  title: string;
  lede?: string;
}

const { src, alt, eyebrow, title, lede } = Astro.props;
---

<section class="relative flex min-h-[88svh] items-center justify-center overflow-hidden bg-ink text-paper md:min-h-[100svh]">
  <BleedPhoto src={src} alt={alt} priority />
  <div class="absolute inset-0 bg-ink/25"></div>
  <div class="relative z-10 mx-auto max-w-3xl px-5 py-28 text-center">
    <p class="eyebrow text-paper/75">{eyebrow}</p>
    <h1 class="font-display mt-4 text-5xl font-normal leading-[0.95] tracking-tight md:text-7xl">
      {title}
    </h1>
    {
      lede && (
        <p class="mt-6 text-base font-light leading-relaxed text-paper/90 md:text-lg">
          {lede}
        </p>
      )
    }
  </div>
</section>
