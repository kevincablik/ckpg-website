---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
}

const {
  src,
  alt,
  widths = [480, 800, 1200, 1800],
  sizes = "(min-width: 1024px) 50vw, 100vw",
  priority = false,
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  class:list={["h-full w-full object-cover", Astro.props.class]}
  loading={priority ? "eager" : "lazy"}
  decoding="async"
  inferSize
/>
