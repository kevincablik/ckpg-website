---
import BaseLayout from "../layouts/BaseLayout.astro";
import BleedPhoto from "../components/BleedPhoto.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
import { midRvrGallery } from "../data/gallery";
---

<BaseLayout
  title={`Contact | ${site.name}`}
  description="Contact CK Property Group about partnerships, land opportunities, and current communities including seventh&franklin Phase 2 and Phase 3, Midtown Heights, Kootenai Townhomes, K2 Apartments, MID RVR, and 410 RVR."
  path="/contact"
  image="/images/midrvr-twilight-02.jpg"
  imageAlt="Completed MID RVR townhomes in Hailey at twilight"
>
  <section class="md:grid md:min-h-[100svh] md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
    <div class="relative min-h-[52vh] bg-ink md:min-h-[100svh]">
      <BleedPhoto src={midRvrGallery[0].src} alt={midRvrGallery[0].alt} priority />
    </div>

    <div class="flex flex-col justify-center bg-paper px-5 py-16 md:px-12 md:py-24 md:pt-32 lg:px-16">
      <p class="eyebrow">Contact</p>
      <h1 class="font-display mt-4 text-5xl leading-[0.95] md:text-6xl">
        Let’s talk about the next site
      </h1>
      <p class="mt-5 max-w-md text-base font-light leading-relaxed text-ink-soft">
        We welcome conversations about partnerships, land opportunities, and current communities.
      </p>
      <dl class="mt-8 space-y-5 border-t border-line pt-6">
        <div>
          <dt class="eyebrow">Email</dt>
          <dd class="mt-2">
            <a class="text-lg underline-offset-4 hover:underline" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Current communities</dt>
          <dd class="mt-2 text-sm font-light leading-relaxed text-muted">
            Current / in progress: seventh&franklin Phase 2 (Building B) and Phase 3 (711 W Franklin), Downtown Boise<br />
            Completed: seventh&franklin Phase 1; Midtown Heights; Kootenai Townhomes; K2 Apartments; 410 RVR; MID RVR
          </dd>
        </div>
      </dl>
      <div class="mt-10">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
