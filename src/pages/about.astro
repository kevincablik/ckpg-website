---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SmartImage from "../components/SmartImage.astro";
import { site } from "../data/site";
import landingDusk from "../assets/images/the-landing-patio-dusk.jpg";
import kevinCablik from "../assets/images/kevin-cablik.jpg";

const landingAlt = "The Landing at Crane Creek Country Club at dusk";
---

<BaseLayout
  title={`About | ${site.name}`}
  description="Founded in 2014 by Anna and Kevin Cablik, CK Property Group is a privately funded urban and infill development company focused on for-sale townhome communities."
  path="/about"
  image="/images/the-landing-patio-dusk.jpg"
  imageAlt={landingAlt}
>
  <PageHero
    src={landingDusk}
    alt={landingAlt}
    eyebrow="About"
    title="Founded in 2014 by Anna and Kevin Cablik"
  />

  <section class="border-t border-line bg-paper-deep/50">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <article class="flex max-w-5xl flex-col gap-8 md:flex-row md:items-start md:gap-12 lg:gap-16">
        <div class="relative aspect-[3/4] w-40 shrink-0 overflow-hidden bg-sand md:w-48 [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:object-[center_18%] [&_picture]:block [&_picture]:h-full [&_picture]:w-full">
          <SmartImage
            src={kevinCablik}
            alt="Kevin Cablik"
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 192px, 160px"
          />
        </div>
        <div class="min-w-0">
          <p class="eyebrow">Founders</p>
          <h2 class="font-display mt-3 text-4xl md:text-5xl">Anna and Kevin Cablik</h2>
          <div class="mt-6 space-y-4 text-[0.98rem] font-light leading-relaxed text-muted">
            <p>
              Anna and Kevin Cablik founded CK Property Group in 2014 as a mother-and-son team. Anna's career in construction includes founding Anatek, Inc., a general contractor, and Anasteel & Supply Company, a reinforcing-steel fabricator, with major civic and commercial projects such as the Atlanta Airport International Terminal and Mercedes-Benz Stadium. She has served on the Truist board and previously served on the board of Georgia Power.
            </p>
            <p>
              Kevin is Managing Partner. He earned a Bachelor of Science in Building Construction from the Georgia Institute of Technology in 2006, and his work in development, construction, and operations includes KC Constructors and KC Property Management alongside CK Property Group's urban infill townhome communities.
            </p>
          </div>
        </div>
      </article>
    </div>
  </section>

</BaseLayout>
