---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProjectFeature from "../components/ProjectFeature.astro";
import { site } from "../data/site";
import {
  completedProjects,
  currentProjects,
  selectPortfolio,
} from "../data/projects";
import {
  kootenaiGallery,
  midRvrGallery,
  midtownHeightsGallery,
  rvr410Gallery,
  seventhFranklinGallery,
  seventhFranklinPhase2Gallery,
  seventhFranklinPhase3Gallery,
} from "../data/gallery";

const galleries = {
  "seventh-and-franklin-phase-2": seventhFranklinPhase2Gallery,
  "seventh-and-franklin-phase-3": seventhFranklinPhase3Gallery,
  "seventh-and-franklin": seventhFranklinGallery,
  "midtown-heights": midtownHeightsGallery,
  "kootenai-townhomes": kootenaiGallery,
  "410-rvr": rvr410Gallery,
  "mid-rvr": midRvrGallery,
} as const;

const landingHero = midtownHeightsGallery[1];

function galleryFor(id: string) {
  return galleries[id as keyof typeof galleries] ?? [];
}
---

<BaseLayout
  title={`Projects | ${site.name}`}
  description="Featured CK Property Group communities including seventh&franklin Phase 2 and Phase 3 in Downtown Boise, and completed seventh&franklin, Midtown Heights, Kootenai Townhomes, and K2 Apartments in Boise, plus MID RVR and 410 RVR in Hailey."
  path="/projects"
  image="/images/midtown-heights-02.jpg"
  imageAlt="Rooftop lounge at Midtown Heights in Boise"
>
  <PageHero
    src={landingHero.src}
    alt={landingHero.alt}
    eyebrow="Projects"
    title="Thoughtfully designed townhome communities"
  />

  <div class="mx-auto max-w-2xl px-5 py-10 text-center md:py-12">
    <p class="text-sm font-light leading-relaxed text-muted md:text-base">
      CK Property Group develops for-sale townhouse communities in highly desirable urban and infill locations. Current work includes seventh&franklin Phase 2 and Phase 3 in Downtown Boise. Completed communities include seventh&franklin, Midtown Heights, Kootenai Townhomes, and K2 Apartments in Boise, and MID RVR and 410 RVR in Hailey.
    </p>
  </div>

  <section>
    <div class="mx-auto max-w-2xl px-5 pb-8 text-center md:pb-10">
      <p class="eyebrow">Current</p>
      <h2 class="font-display mt-3 text-4xl md:text-5xl">In progress</h2>
    </div>
    {
      currentProjects.map((project) => (
        <ProjectFeature project={project} gallery={galleryFor(project.id)} />
      ))
    }
  </section>

  <section>
    <div class="mx-auto max-w-2xl px-5 py-12 text-center md:py-16">
      <p class="eyebrow">Completed</p>
      <h2 class="font-display mt-3 text-4xl md:text-5xl">Delivered communities</h2>
    </div>
    {
      completedProjects.map((project) =>
        project.photosPending ? (
          <article id={project.id} class="scroll-mt-20">
            <div class="mx-auto max-w-2xl px-5 py-16 text-center md:py-20">
              <p class="eyebrow">{project.kicker}</p>
              <h2 class="font-display mt-4 text-5xl font-normal leading-[1.05] tracking-tight md:text-7xl">
                {project.name}
              </h2>
              <p class="font-display mt-3 text-xl italic text-muted md:text-2xl">{project.headline}</p>
              {project.body.map((paragraph) => (
                <p class="mt-6 text-[0.98rem] font-light leading-relaxed text-muted">{paragraph}</p>
              ))}
            </div>
          </article>
        ) : (
          <ProjectFeature project={project} gallery={galleryFor(project.id)} />
        )
      )
    }
  </section>

  <section class="border-t border-line bg-paper-deep/50">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="eyebrow">Select portfolio</p>
      <h2 class="font-display mt-3 text-4xl">Additional communities</h2>
      <ul class="mt-12 grid gap-0 sm:grid-cols-2">
        {
          selectPortfolio.map((item) => (
            <li class="flex items-baseline justify-between gap-6 border-t border-line py-5">
              <span>{item.name}</span>
              <span class="text-sm tracking-wide text-stone">
                {"status" in item && item.status ? `${item.status} · ${item.place}` : item.place}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-sm text-muted">Atlanta work also includes others beyond the communities listed here.</p>
    </div>
  </section>
</BaseLayout>
