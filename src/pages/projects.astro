---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProjectTile from "../components/ProjectTile.astro";
import { site } from "../data/site";
import { completedProjects, currentProjects, selectPortfolio } from "../data/projects";
import { midtownHeightsGallery, tileCover } from "../data/gallery";
---

<BaseLayout
  title={`Projects | ${site.name}`}
  description="Current and completed CK Property Group communities, including Seventh & Franklin in Downtown Boise, Midtown Heights, Kootenai Townhomes, K2 Apartments, 410 RVR, and MID RVR."
  path="/projects"
  image="/images/midtown-heights-roof-1.jpg"
  imageAlt="Rooftop terrace rendering at Midtown Heights in Boise"
>
  <PageHero
    src={midtownHeightsGallery[0].src}
    alt={midtownHeightsGallery[0].alt}
    eyebrow="Projects"
    title="Thoughtfully designed communities"
  />

  <div class="mx-auto max-w-2xl px-5 py-10 text-center md:py-12">
    <p class="text-sm font-light leading-relaxed text-muted md:text-base">
      For-sale townhome and multifamily communities in urban and infill locations, including Downtown Boise and Hailey.
    </p>
  </div>

  <section class="mx-auto max-w-[1400px] px-5 pb-6 md:px-8 md:pb-10">
    <h2 class="font-display text-4xl md:text-5xl">Current</h2>
    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
      {
        currentProjects.map((project) => {
          const cover = tileCover(project.id);
          return (
            <ProjectTile
              href={project.href}
              name={project.name}
              line={project.line}
              src={cover.src}
              alt={cover.alt}
            />
          );
        })
      }
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 py-12 md:px-8 md:py-16">
    <h2 class="font-display text-4xl md:text-5xl">Completed</h2>
    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
      {
        completedProjects.map((project) => {
          const cover = tileCover(project.id);
          return (
            <ProjectTile
              href={project.href}
              name={project.name}
              line={project.line}
              src={cover.src}
              alt={cover.alt}
            />
          );
        })
      }
    </div>
  </section>

  <section class="border-t border-line bg-paper-deep/50">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="eyebrow">Select portfolio</p>
      <h2 class="font-display mt-3 text-4xl">Additional communities</h2>
      <ul class="mt-12 grid gap-0 sm:grid-cols-2">
        {
          selectPortfolio.map((item) => (
            <li class="flex items-baseline justify-between gap-6 border-t border-line py-5">
              <span>{item.name}</span>
              <span class="text-sm tracking-wide text-stone">{item.place}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
