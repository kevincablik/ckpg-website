---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProjectFeature from "../components/ProjectFeature.astro";
import { site } from "../data/site";
import { midRvr, rvr410, selectPortfolio, seventhAndFranklin } from "../data/projects";
import { midRvrGallery, rvr410Gallery, seventhFranklinGallery } from "../data/gallery";
---

<BaseLayout
  title={`Projects | ${site.name}`}
  description="Featured CK Property Group communities including seventh&franklin in Downtown Boise, MID RVR in Hailey, and completed 410 RVR in Hailey, plus a select portfolio of urban infill townhomes."
  path="/projects"
  image="/images/seventh-franklin-exterior.jpg"
  imageAlt="Exterior of seventh&franklin in Downtown Boise"
>
  <PageHero
    src={seventhFranklinGallery[0].src}
    alt={seventhFranklinGallery[0].alt}
    eyebrow="Projects"
    title="Thoughtfully designed townhome communities"
  />

  <div class="mx-auto max-w-2xl px-5 py-10 text-center md:py-12">
    <p class="text-sm font-light leading-relaxed text-muted md:text-base">
      CK Property Group develops for-sale townhouse communities in highly desirable urban and infill locations. Featured work includes seventh&franklin in Downtown Boise, MID RVR in Hailey, and completed 410 RVR in Hailey.
    </p>
  </div>

  <ProjectFeature project={seventhAndFranklin} gallery={seventhFranklinGallery} />
  <ProjectFeature project={midRvr} gallery={midRvrGallery} />
  <ProjectFeature project={rvr410} gallery={rvr410Gallery} />

  <section class="border-t border-line bg-paper-deep/50">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="eyebrow">Select portfolio</p>
      <h2 class="font-display mt-3 text-4xl">Additional communities</h2>
      <ul class="mt-12 grid gap-0 sm:grid-cols-2">
        {
          selectPortfolio.map((item) => (
            <li class="flex items-baseline justify-between gap-6 border-t border-line py-5">
              <span>{item.name}</span>
              <span class="text-sm tracking-wide text-stone">
                {"status" in item && item.status ? `${item.status} · ${item.place}` : item.place}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-sm text-muted">Atlanta work also includes others beyond the communities listed here.</p>
    </div>
  </section>
</BaseLayout>
