---
import BaseLayout from "../layouts/BaseLayout.astro";
import BleedPhoto from "../components/BleedPhoto.astro";
import ButtonLink from "../components/ButtonLink.astro";
import ProjectPoster from "../components/ProjectPoster.astro";
import ImageStrip from "../components/ImageStrip.astro";
import { site } from "../data/site";
import {
  atlantaCommunities,
  homePortfolio,
  howWeWork,
  midRvr,
  rvr410,
  seventhAndFranklinPhase2,
} from "../data/projects";
import {
  homeBleed,
  homeHero,
  homeStrip,
  midRvrGallery,
  rvr410Gallery,
  seventhFranklinGallery,
  seventhFranklinPhase2Gallery,
} from "../data/gallery";
---

<BaseLayout
  title={`${site.name} | Urban Infill Development`}
  description={site.description}
  path="/"
  image="/images/seventh-franklin-phase2-01.jpg"
  imageAlt="Exterior of seventh&franklin Phase 2 in Downtown Boise"
>
  <section class="relative min-h-[100svh] overflow-hidden bg-ink text-paper">
    <BleedPhoto src={homeHero.src} alt={homeHero.alt} priority />
    <div class="absolute inset-0 bg-ink/30"></div>
    <div class="relative mx-auto flex min-h-[100svh] max-w-3xl flex-col items-center justify-center px-5 py-28 text-center">
      <h1 class="font-display text-5xl font-normal leading-[0.95] tracking-tight md:text-7xl">
        Prime locations.<br />Sophisticated design.<br />Quality execution.
      </h1>
      <div class="mt-10">
        <ButtonLink href="/projects" variant="light">View Our Projects</ButtonLink>
      </div>
    </div>
  </section>

  <section>
    <div class="relative min-h-[78svh] bg-ink md:min-h-[88svh]">
      <BleedPhoto src={seventhFranklinGallery[1].src} alt={seventhFranklinGallery[1].alt} />
    </div>
    <div class="mx-auto max-w-2xl px-5 py-16 text-center md:py-20">
      <p class="eyebrow">Who we are</p>
      <h2 class="font-display mt-4 text-4xl leading-tight md:text-5xl">A mother-and-son team</h2>
      <p class="mt-6 text-base font-light leading-relaxed text-ink-soft">
        Founded in 2014 by Anna and Kevin Cablik, CK Property Group brings together construction expertise and careful site selection to deliver residential communities in places people want to live.
      </p>
      <p class="mt-4 text-sm font-light leading-relaxed text-muted">
        As a mother-and-son team with decades of combined experience in residential and commercial construction, we emphasize thorough due diligence, financial strength, and craftsmanship at every stage of a project. CK Property Group is a privately funded urban and infill development company focused on attainable, high-quality for-sale townhouse communities.
      </p>
      <div class="mt-10 flex justify-center">
        <ButtonLink href="/about" variant="dark">About CK Property Group</ButtonLink>
      </div>
    </div>
  </section>

  <section class="bg-paper pb-8 pt-6 md:pb-12 md:pt-10">
    <h2 class="font-display px-5 text-center text-4xl md:text-5xl">Featured communities</h2>
    <div class="mt-10 px-4 md:px-10">
      <ProjectPoster project={seventhAndFranklinPhase2} image={seventhFranklinPhase2Gallery[0]} featured />
    </div>
    <div class="mt-6 grid gap-6 px-4 md:mt-8 md:grid-cols-2 md:px-10">
      <ProjectPoster project={midRvr} image={midRvrGallery[0]} overlay={false} />
      <ProjectPoster project={rvr410} image={rvr410Gallery[0]} overlay={false} />
    </div>
  </section>

  <section class="relative min-h-[88svh] overflow-hidden bg-ink text-paper md:min-h-[100svh]">
    <BleedPhoto src={homeBleed.src} alt={homeBleed.alt} />
    <div class="absolute inset-0 bg-ink/20"></div>
    <div class="relative mx-auto flex min-h-[88svh] items-end justify-center px-5 py-16 text-center md:min-h-[100svh] md:py-20">
      <div>
        <p class="eyebrow text-paper/75">{homeBleed.caption}</p>
        <p class="font-display mt-3 text-4xl md:text-6xl">Downtown Boise</p>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper-deep/60">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <p class="eyebrow">How we work</p>
      <h2 class="font-display mt-3 max-w-xl text-4xl md:text-5xl">
        Prime locations. Sophisticated design. Quality execution.
      </h2>
      <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-10">
        {
          howWeWork.map((item) => (
            <div class="border-t border-line pt-8">
              <p class="font-display text-2xl text-stone">{item.number}</p>
              <h3 class="mt-4 text-lg tracking-wide">{item.title}</h3>
              <p class="mt-4 text-sm font-light leading-relaxed text-muted">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-line py-16 md:py-20">
    <div class="px-5 md:px-10">
      <p class="eyebrow">Selected views</p>
      <h2 class="font-display mt-3 mb-8 text-4xl">Boise and Hailey</h2>
    </div>
    <ImageStrip images={homeStrip} />
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="eyebrow">Select portfolio</p>
      <h2 class="font-display mt-3 text-4xl">Communities by name</h2>
      <p class="mt-4 max-w-2xl text-sm font-light leading-relaxed text-muted">
        In addition to seventh&franklin—including Phase 2 and Phase 3—completed Midtown Heights, MID RVR, and completed 410 RVR, CK Property Group’s work includes the following communities.
      </p>
      <ul class="mt-10 divide-y divide-line border-y border-line">
        {
          homePortfolio.map((item) => (
            <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between">
              <span class="text-lg">{item.name}</span>
              <span class="text-sm tracking-wide text-stone">
                {"status" in item && item.status ? `${item.status} · ${item.place}` : item.place}
              </span>
            </li>
          ))
        }
        <li class="py-5">
          <p class="text-lg">Atlanta communities</p>
          <p class="mt-2 text-sm font-light leading-relaxed text-muted">
            Including {atlantaCommunities.join(", ")}, and others.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="bg-ink text-paper">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-16 md:flex-row md:items-end md:justify-between md:px-8 md:py-20">
      <div class="max-w-xl">
        <p class="eyebrow text-paper/50">Start a conversation</p>
        <h2 class="font-display mt-4 text-4xl leading-tight md:text-5xl">
          Partnerships, land, and current communities.
        </h2>
      </div>
      <ButtonLink href="/contact" variant="light">Get in Touch</ButtonLink>
    </div>
  </section>
</BaseLayout>
