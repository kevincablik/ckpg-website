---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BleedPhoto from "../../components/BleedPhoto.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import SmartImage from "../../components/SmartImage.astro";
import { site } from "../../data/site";
import { seventhAndFranklin, seventhFranklinPhases } from "../../data/projects";
import {
  seventhFranklinGallery,
  seventhFranklinPhase2Gallery,
  seventhFranklinPhase3Gallery,
} from "../../data/gallery";
import type { GalleryImage } from "../../data/gallery";

const project = seventhAndFranklin;
const hero = seventhFranklinGallery[0];
const phaseGalleries: GalleryImage[][] = [
  seventhFranklinGallery.slice(1),
  seventhFranklinPhase2Gallery,
  seventhFranklinPhase3Gallery,
];

type GalleryFrame = {
  portrait: boolean;
  wide: boolean;
};

// A clearly portrait photo (the roof-deck fireplace) spans two rows at its own
// aspect ratio so the fireplace is not cropped into a 3:2 frame. Slightly tall
// images stay in the landscape grid.
function framesFor(images: GalleryImage[]): GalleryFrame[] {
  const columns = 2;
  const occupied = new Set<string>();
  let row = 0;
  let col = 0;
  const placed: { portrait: boolean; row: number; rowSpan: number }[] = [];

  const advanceToFreeCell = () => {
    while (occupied.has(`${row}:${col}`)) {
      col += 1;
      if (col >= columns) {
        col = 0;
        row += 1;
      }
    }
  };

  for (const image of images) {
    advanceToFreeCell();
    const portrait = image.src.height / image.src.width > 1.25;
    const rowSpan = portrait ? 2 : 1;
    occupied.add(`${row}:${col}`);
    if (portrait) occupied.add(`${row + 1}:${col}`);
    placed.push({ portrait, row, rowSpan });
    col += 1;
    if (col >= columns) {
      col = 0;
      row += 1;
    }
  }

  const occupants = new Map<number, number>();
  for (const item of placed) {
    for (let spanned = item.row; spanned < item.row + item.rowSpan; spanned += 1) {
      occupants.set(spanned, (occupants.get(spanned) ?? 0) + 1);
    }
  }

  return placed.map((item) => ({
    portrait: item.portrait,
    wide: !item.portrait && (occupants.get(item.row) ?? 0) === 1,
  }));
}
---

<BaseLayout
  title={`${project.name} | ${site.name}`}
  description={project.summary}
  path={`/projects/${project.id}`}
  image={project.image.src}
  imageAlt={project.image.alt}
>
  <section class="relative flex min-h-[78svh] items-end overflow-hidden bg-ink text-paper md:min-h-[88svh]">
    <BleedPhoto src={hero.src} alt={hero.alt} priority />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/20 to-ink/25"></div>
    <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pb-12 pt-32 md:px-8 md:pb-16">
      <p class="eyebrow text-paper/80">{project.line}</p>
      <h1 class="font-display mt-3 max-w-4xl text-5xl font-normal leading-[0.95] tracking-tight md:text-7xl">
        {project.name}
      </h1>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-2xl px-5 py-14 text-center md:py-20">
      <p>
        <a href="/projects" class="text-[0.7rem] font-medium tracking-[0.18em] text-stone uppercase">
          All projects
        </a>
      </p>
      <div class="mt-8 space-y-4">
        {
          project.body.map((paragraph) => (
            <p class="text-[0.98rem] font-light leading-relaxed text-muted">{paragraph}</p>
          ))
        }
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {
          project.externalUrl && (
            <ButtonLink href={project.externalUrl} variant="ghost-dark" external>
              {project.externalLabel ?? "Project site"}
            </ButtonLink>
          )
        }
        <ButtonLink href={`/contact?interest=${project.id}`} variant="dark">
          Inquire
        </ButtonLink>
      </div>
    </div>
  </section>

  {
    seventhFranklinPhases.map((phase, phaseIndex) => {
      const images = phaseGalleries[phaseIndex];
      const frames = framesFor(images);
      return (
        <section class="border-t border-line">
          <div class="mx-auto max-w-2xl px-5 py-12 text-center md:py-16">
            <p class="eyebrow">{phase.line}</p>
            <h2 class="font-display mt-3 text-4xl md:text-5xl">{phase.title}</h2>
            <div class="mt-6 space-y-4">
              {phase.paragraphs.map((paragraph) => (
                <p class="text-[0.98rem] font-light leading-relaxed text-muted">{paragraph}</p>
              ))}
            </div>
          </div>
          <div class="mx-auto grid max-w-5xl grid-cols-1 gap-3 px-5 pb-12 sm:grid-cols-2 sm:items-start md:px-8 md:pb-16">
            {images.map((image, index) => {
              const frame = frames[index];
              return (
                <figure
                  class:list={[
                    "relative overflow-hidden bg-ink",
                    frame.portrait
                      ? "sm:row-span-2"
                      : frame.wide
                        ? "aspect-[3/2] sm:col-span-2"
                        : "aspect-[3/2]",
                  ]}
                  style={
                    frame.portrait
                      ? { aspectRatio: `${image.src.width} / ${image.src.height}` }
                      : undefined
                  }
                >
                  <SmartImage
                    src={image.src}
                    alt={image.alt}
                    class="absolute inset-0"
                    sizes={
                      frame.wide
                        ? "(min-width: 640px) 64rem, 100vw"
                        : "(min-width: 640px) 32rem, 100vw"
                    }
                  />
                </figure>
              );
            })}
          </div>
        </section>
      );
    })
  }
</BaseLayout>
